DATABASE_URL=postgres://mesta:mesta@localhost:5433/mesta
# HTTP Basic Auth for /admin — username is fixed as "admin", set a real password before deploying.
ADMIN_PASSWORD=change-me
# Used by sitemap.xml/robots.txt for absolute URLs — set to https://mesta.city in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 — photo uploads from /admin/places (see lib/r2.ts).
# R2_ACCOUNT_ID: Cloudflare dashboard → R2 → Overview (right sidebar).
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: R2 → Manage API Tokens → create an "Object Read & Write" token.
# R2_BUCKET: the bucket name you created for photos.
# R2_PUBLIC_URL: the bucket's public access URL (R2 → bucket → Settings → Public access →
#   either the r2.dev subdomain, or a custom domain you connect) — must serve objects at
#   <R2_PUBLIC_URL>/<key> with no auth.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mesta-photos
R2_PUBLIC_URL=
